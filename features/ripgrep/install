#!/bin/sh
set -e

mkdir -p /usr/local/bin
cp -p rg /usr/local/bin/rg

mkdir -p /usr/local/share/man/man1
cp -p doc/rg.1 /usr/local/share/man/man1/rg.1

mkdir -p /usr/local/share/bash-completion/completions
cp -p complete/rg.bash /usr/local/share/bash-completion/completions/rg

mkdir -p /usr/local/share/zsh/site-functions
cp -p complete/_rg /usr/local/share/zsh/site-functions/_rg

mkdir -p /usr/local/share/fish/vendor_completions.d
cp -p complete/rg.fish /usr/local/share/fish/vendor_completions.d/rg.fish

mkdir -p /usr/local/share/doc/ripgrep
cp -p COPYING LICENSE-MIT UNLICENSE /usr/local/share/doc/ripgrep/
