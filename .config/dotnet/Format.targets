<Project>
  <Target Name="DotNetFormatCheck" Condition="'$(DotNetFormatCheck)' == 'true'" AfterTargets="GetTargetPath">
    <Exec
      Command="dotnet format style --verify-no-changes --severity info"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    />
  </Target>

  <Target Name="DotNetFormat" Condition="'$(DotNetFormat)' == 'true'" AfterTargets="GetTargetPath">
    <Exec Command="dotnet format style --severity info" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
